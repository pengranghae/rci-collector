      "keywords": ["채용", "신입", "SKCT"],
      "exclude_title": ["경력"]
    },
    {"id": "posco_newsroom", "name": "포스코 뉴스룸", "preset": "official", "default_company": "포스코그룹", "require_company": false, "feeds": ["https://newsroom.posco.com/kr/feed/"]},
